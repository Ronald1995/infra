{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resolved EP benchmark configuration v1",
  "type": "object",
  "required": [
    "schema_version",
    "device",
    "suite_id",
    "distributed",
    "model",
    "workload",
    "benchmark",
    "topology",
    "operators"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "device": {
      "enum": [
        "npu",
        "cpu"
      ]
    },
    "model": {
      "type": "object",
      "required": [
        "hidden_size",
        "intermediate_size",
        "num_experts",
        "top_k",
        "dtype"
      ]
    },
    "distributed": {
      "type": "object",
      "required": [
        "ep_size",
        "tp_size",
        "timeout_seconds"
      ],
      "properties": {
        "hierarchical_inner_size": {"type": "integer", "minimum": 2}
      }
    },
    "workload": {
      "type": "object",
      "properties": {
        "router_bias": {"enum": ["rotating_hot_expert", "remote_rank", null]}
      }
    },
    "benchmark": {
      "type": "object",
      "properties": {
        "planner_steps": {"type": "integer", "minimum": 2}
      }
    }
  }
}
