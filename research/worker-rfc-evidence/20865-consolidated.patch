 class WorkerInheritanceContract(unittest.TestCase):
+    def test_unverified_methods_and_properties_raise_before_accessing_state(self):
+        names = worker_interfaces()["UNVERIFIED_GPU_WORKER_METHODS"]
+        self.assertIsInstance(names, tuple)
+        self.assertEqual(len(names), len(set(names)))
+        for name in names:
+            with self.subTest(method=name):
+                method = worker_method(name)
+                if isinstance(method, property):
+                    with self.assertRaisesRegex(NotImplementedError, name):
+                        method.__get__(object(), object)
+                    continue
+                parameters = list(inspect.signature(method).parameters.values())[1:]
+                required = [p for p in parameters if p.default is inspect.Parameter.empty]
+                args = [object()] + [
+                    object()
+                    for p in required
+                    if p.kind in (inspect.Parameter.POSITIONAL_ONLY, inspect.Parameter.POSITIONAL_OR_KEYWORD)
+                ]
+                kwargs = {p.name: object() for p in required if p.kind is inspect.Parameter.KEYWORD_ONLY}
+                with self.assertRaisesRegex(NotImplementedError, name):
+                    method(*args, **kwargs)
+
+    def test_unverified_registry_matches_explicit_stubs(self):
+        observed = set()
+        for method in worker_class().body:
+            if not isinstance(method, ast.FunctionDef) or len(method.body) != 1:
+                continue
+            statement = method.body[0]
+            if (
+                isinstance(statement, ast.Raise)
+                and isinstance(statement.exc, ast.Call)
+                and isinstance(statement.exc.func, ast.Name)
+                and statement.exc.func.id == "NotImplementedError"
+            ):
+                observed.add(method.name)
+        self.assertEqual(observed, set(worker_interfaces()["UNVERIFIED_GPU_WORKER_METHODS"]))
+
