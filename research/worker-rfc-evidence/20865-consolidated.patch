+    def test_constructor_rejects_missing_hooks_and_fault_tolerance(self):
+        constructor = next(
+            node for node in worker_class().body if isinstance(node, ast.FunctionDef) and node.name == "__init__"
+        )
+        guards = [
+            copy.deepcopy(node)
+            for node in constructor.body
+            if isinstance(node, ast.If)
+            and any(
+                isinstance(statement, ast.Raise)
+                and isinstance(statement.exc, ast.Call)
+                and isinstance(statement.exc.func, ast.Name)
+                and statement.exc.func.id in ("RuntimeError", "NotImplementedError")
+                for statement in node.body
+            )
+        ]
+        self.assertEqual(len(guards), 2)
+        module = ast.fix_missing_locations(ast.Module(body=guards, type_ignores=[]))
+        hooks = {name: object() for name in ("_make_elastic_ep_executor", "_validate_profiler_config")}
+        for missing in (None, *hooks):
+            for fault_tolerance in (False, True):
+                with self.subTest(missing=missing, fault_tolerance=fault_tolerance):
+                    scope = {
+                        "GPUWorker": SimpleNamespace(
+                            **{name: value for name, value in hooks.items() if name != missing}
+                        ),
+                        "vllm_config": SimpleNamespace(
+                            parallel_config=SimpleNamespace(enable_fault_tolerance=fault_tolerance)
+                        ),
+                    }
+                    if missing is not None:
+                        with self.assertRaisesRegex(RuntimeError, "platform hooks"):
+                            exec(compile(module, str(WORKER), "exec"), scope)
+                    elif fault_tolerance:
+                        with self.assertRaisesRegex(NotImplementedError, "fault-tolerance"):
+                            exec(compile(module, str(WORKER), "exec"), scope)
+                    else:
+                        exec(compile(module, str(WORKER), "exec"), scope)
+
