+# SPDX-License-Identifier: Apache-2.0
+"""Check the quarantine against the actual installed vLLM Worker surface."""
+
+import inspect
+from types import SimpleNamespace
+
+from vllm_ascend.worker.worker_interfaces import UNVERIFIED_GPU_WORKER_METHODS
+
+
+def test_no_unverified_gpu_worker_interface_is_inherited():
+    from vllm.v1.worker.gpu_worker import Worker as GPUWorker
+
+    from vllm_ascend.worker.worker import NPUWorker
+
+    parent_interfaces = {
+        name
+        for name, member in vars(GPUWorker).items()
+        if inspect.isfunction(member) or isinstance(member, (property, classmethod, staticmethod))
+    }
+    assert NPUWorker.__bases__ == (GPUWorker,)
+    assert not parent_interfaces - vars(NPUWorker).keys(), "New upstream interfaces require an explicit NPU boundary."
+    assert set(UNVERIFIED_GPU_WORKER_METHODS) <= parent_interfaces
+    for name in UNVERIFIED_GPU_WORKER_METHODS:
+        assert inspect.getattr_static(NPUWorker, name) is not inspect.getattr_static(GPUWorker, name)
+
+
+def test_parent_constructor_initializes_common_state(monkeypatch):
+    from vllm.v1.worker import gpu_worker
+
+    from vllm_ascend.worker.worker import NPUWorker
+
+    config = SimpleNamespace(
+        use_v2_model_runner=False,
+        parallel_config=SimpleNamespace(enable_fault_tolerance=False),
+        profiler_config=None,
+    )
+    calls = []
+
+    def init_worker_base(self, **kwargs):
+        calls.append(kwargs)
+        self.vllm_config = kwargs["vllm_config"]
+        self.parallel_config = self.vllm_config.parallel_config
+
+    monkeypatch.setattr(gpu_worker.WorkerBase, "__init__", init_worker_base)
+    monkeypatch.setattr(gpu_worker.torch, "set_float32_matmul_precision", lambda precision: None)
+    worker = object.__new__(NPUWorker)
+    gpu_worker.Worker.__init__(worker, config, 0, 0, "env://")
+
+    assert len(calls) == 1
+    assert calls[0]["vllm_config"] is config
+    assert worker._sleep_saved_buffers == {}
+    assert worker._sleep_saved_parameters == {}
+    assert worker._sleep_saved_draft_buffers == {}
+    assert worker.weight_transfer_engine is None
+    assert worker._weight_update_active is False
+    assert worker._weight_update_is_draft is False
+    assert worker.profiler is None
+    assert worker._pp_send_work == []
+    assert worker._sleep_mode_backend is None
+    assert worker.worker_sentinel is None
+    assert vars(worker.elastic_ep_executor) == {}
